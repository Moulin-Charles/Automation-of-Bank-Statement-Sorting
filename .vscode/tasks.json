{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Extraire un releve",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["extract_releve.py", "${input:cheminPdf}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Installer les dependances",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "cheminPdf",
      "type": "promptString",
      "description": "Chemin du releve PDF",
      "default": "${workspaceFolder}\\tests\\data\\releve_exemple.pdf"
    }
  ]
}
